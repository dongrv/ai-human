# Copy this file to .env for local model calls.
# Never commit real API keys.

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

AI_HUMAN_MODEL_PROVIDER=openai
AI_HUMAN_MODEL=gpt-4o-mini
AI_HUMAN_OPENAI_WIRE_API=responses

# Set to 1 only when diagnosing provider payload compatibility.
AI_HUMAN_OPENAI_DEBUG_RAW=0

# Optional local no-network response for smoke testing.
# AI_HUMAN_MOCK_RESPONSE=mock answer
